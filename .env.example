# Copy this file to .env at the repository root. Never commit .env.
PORT=3001
# Preferred over PORT (some launchers set PORT for the web dev server).
API_PORT=3001
APP_ORIGIN=http://127.0.0.1:5173
DATABASE_PATH=.data/proofpatch
NODE_ENV=development
# Optional. Both values must be present to provision a reviewer on server startup.
# Set a unique password of at least 12 characters. No default account is created.
REVIEWER_EMAIL=
REVIEWER_PASSWORD=
REVIEWER_NAME=Security Reviewer
# Optional public local-demo form fill. Disabled unless explicitly set to true.
# Reads the configured reviewer above; production builds omit this feature.
REVIEWER_DEMO_ENABLED=false
# Public demo: also fill the demo logins on a production build and create the demo developer there.
# The demo passwords then ship in the public site bundle - hackathon only, never real passwords.
PUBLIC_DEMO=false
# Optional local demo developer (created at startup in development; autofilled when demo is enabled).
DEVELOPER_DEMO_EMAIL=
DEVELOPER_DEMO_PASSWORD=
# Production requires HTTPS, APP_ORIGIN=https://your-domain, NODE_ENV=production.

# --- Agent pipeline ---------------------------------------------------------
# AI providers (server-side only). Tried in AI_PROVIDER_ORDER; the next one is the fallback.
AI_PROVIDER_ORDER=groq,gemini
GEMINI_API_KEY=
# Optional extra keys: when one key hits its rate limit the next is used at once.
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_MODEL=openai/gpt-oss-120b
# Groq free tier allows ~8,000 tokens/minute (prompt + max output count).
GROQ_TOKEN_BUDGET=8000
AI_TIMEOUT_MS=90000
# Hard cap on AI tokens per analysis run.
RUN_TOKEN_BUDGET=30000
# Docker sandbox image. Build once: docker build -t proofpatch-runner:py312 docker/runner
SANDBOX_IMAGE=proofpatch-runner:py312
# Full path to docker if it is not on PATH (e.g. D:/Docker/resources/bin/docker.exe).
DOCKER_BIN=
# Clones, dependency folders and scratch output.
WORK_PATH=.data/work

# Optional trained vulnerability locator (see ml/README.md). Leave unset to use rules + Bandit only.
DETECTOR_PYTHON=
DETECTOR_DIR=
DETECTOR_MODEL=
HF_HOME=

# Optional trusted Python executable for the saved Java mini classifier.
# Install ml/mini_classifier/requirements.txt in that runtime; never a user-supplied path.
MINI_ML_PYTHON=
