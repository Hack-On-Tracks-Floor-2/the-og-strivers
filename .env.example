# Copy this file to .env at the repository root. Never commit .env.
PORT=3001
APP_ORIGIN=http://127.0.0.1:5173
DATABASE_PATH=.data/proofpatch
NODE_ENV=development
# Optional. Both values must be present to provision a reviewer on server startup.
# Set a unique password of at least 12 characters. No default account is created.
REVIEWER_EMAIL=
REVIEWER_PASSWORD=
REVIEWER_NAME=Security Reviewer
# Production requires HTTPS, APP_ORIGIN=https://your-domain, NODE_ENV=production.
