# Copy this file to .env at the repository root. Never commit .env.
PORT=3001
# Preferred over PORT (some launchers set PORT for the web dev server).
API_PORT=3001
APP_ORIGIN=http://127.0.0.1:5173
DATABASE_PATH=.data/proofpatch
NODE_ENV=development
# Optional. Both values must be present to provision a reviewer on server startup.
# Set a unique password of at least 12 characters. No default account is created.
REVIEWER_EMAIL=
REVIEWER_PASSWORD=
REVIEWER_NAME=Security Reviewer
# Optional public local-demo form fill. Disabled unless explicitly set to true.
# Reads the configured reviewer above; production builds omit this feature.
REVIEWER_DEMO_ENABLED=false
# Production requires HTTPS, APP_ORIGIN=https://your-domain, NODE_ENV=production.

# --- Agent pipeline ---------------------------------------------------------
# AI providers (server-side only). Tried in AI_PROVIDER_ORDER; the next one is the fallback.
AI_PROVIDER_ORDER=groq,gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Groq free tier allows ~8,000 tokens/minute (prompt + max output count).
GROQ_TOKEN_BUDGET=8000
AI_TIMEOUT_MS=90000
# Hard cap on AI tokens per analysis run.
RUN_TOKEN_BUDGET=30000
# Docker sandbox image. Build once: docker build -t proofpatch-runner:py312 docker/runner
SANDBOX_IMAGE=proofpatch-runner:py312
# Clones, dependency folders and scratch output.
WORK_PATH=.data/work
